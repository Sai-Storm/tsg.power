# Cloudflare response headers (copied into dist/ by the build).

# Every page: basic browser protections.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

# Built files have a content hash in their name, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell and service worker must always be checked for updates,
# otherwise people keep running an old version after a deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
