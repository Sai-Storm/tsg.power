# Copy to .env and edit. Never commit .env.
FLASK_APP=wsgi.py
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=mysql+pymysql://gcsms_app:<url-encoded-password>@127.0.0.1:3306/gcsms?charset=utf8mb4
UPLOAD_FOLDER=instance/uploads
APP_TIMEZONE=Asia/Kolkata
RATELIMIT_STORAGE_URI=memory://
# Optional: MySQL database used ONLY by the concurrency test (it creates/drops tables!)
# TEST_MYSQL_URL=mysql+pymysql://gcsms_user:CHANGE_ME@localhost:3306/gcsms_test?charset=utf8mb4
